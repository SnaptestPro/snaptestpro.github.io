{
  "name": "snaptestpro-app",
  "version": "1.4.54",
  "private": true,
  "description": "SmarTest Pro - web (Firebase Hosting) + Android app (Capacitor, built on GitHub Actions)",
  "scripts": {
    "stamp": "node scripts/stamp-version.js",
    "stamp:check": "node scripts/stamp-version.js --check",
    "build:www": "node scripts/stamp-version.js && node scripts/build-www.js",
    "check:precache": "node scripts/check-precache.js",
    "android:add": "npx cap add android && node scripts/android-prepare.js",
    "android:sync": "node scripts/build-www.js && npx cap sync android && node scripts/android-prepare.js",
    "test": "node scripts/run-unit-tests.js",
    "test:unit": "node scripts/run-unit-tests.js",
    "test:rules": "firebase emulators:exec --only firestore,storage --project demo-snaptest \"node tests/security-rules.test.js\""
  },
  "dependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/cli": "^6.2.0",
    "@capacitor/core": "^6.2.0",
    "@capacitor/app": "^6.0.0",
    "@capacitor/browser": "^6.0.0",
    "@capacitor/filesystem": "^6.0.0",
    "@capacitor/share": "^6.0.0",
    "@capacitor-firebase/app-check": "^6.3.1",
    "@capacitor-firebase/messaging": "^6.3.1",
    "firebase": "^10.14.0"
  },
  "devDependencies": {
    "sharp": "^0.33.5",
    "@firebase/rules-unit-testing": "^3.0.4",
    "firebase-tools": "13.29.1",
    "eslint": "^8.57.0",
    "jsdom": "^24.0.0",
    "acorn": "^8.11.0"
  }
}
