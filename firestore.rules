rules_version = '2';

// ══════════════════════════════════════════════════════════════════
// SnapTest Pro — FIRESTORE SECURITY RULES
// ══════════════════════════════════════════════════════════════════
// IMPORTANT — README pehle padhein: FIREBASE_SECURITY_SETUP.md
//
// Ye rules maan kar chalti hain ki:
//   1) Firebase Console > Authentication mein "Anonymous" provider ON hai
//      (har visitor — student ho ya admin — silently sign-in ho jata hai,
//       taaki request.auth kabhi null na ho).
//   2) Firebase Console > Authentication mein "Email/Password" provider ON hai
//      (real admin login ke liye).
//   3) Neeche ADMIN_EMAILS list mein apna asli admin email daal diya hai.
//      Jab tak yahan email nahi daalenge, KOI BHI admin panel se
//      likh/delete nahi kar payega — is file ko deploy karne ke baad
//      ye pehla kaam hai jo karna hai.
//   4) Neeche OWNER_EMAIL mein apna (product owner ka) email daal diya
//      hai — sirf yehi ek email "Owner Panel" khol sakta hai jahan se
//      har institute ka admin add/disable/remove aur uska password
//      reset kiya ja sakta hai. Details: OWNER_PANEL_SETUP.md
// ══════════════════════════════════════════════════════════════════

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Owner (product/company owner — sabse upar ka role) ────────
    // Ye admin se ALAG hai: owner kisi ek institute ka data nahi
    // chalata, balki OWNER PANEL se ye control karta hai ki kaun-kaun
    // se institutes hain aur unka admin kaun hai (naya admin add
    // karna, kisi admin ko disable/remove karna, uska password reset
    // bhejna). Sirf EK hardcoded email — kisi ko is se access nahi
    // milta jab tak yahan email daal ke publish na karein.
    function isOwner() {
      return request.auth != null &&
        request.auth.token.email != null &&
        request.auth.token.email == "vishnu1234stm@gmail.com";
    }

    // ── Admin allow-list ─────────────────────────────────────────
    // Do tareeke se koi admin banta hai:
    //   (a) LEGACY: neeche seedha email likh diya (purana single-admin
    //       tareeka — backward compatibility ke liye rakha hai).
    //   (b) OWNER PANEL se banaya gaya admin: Owner Panel jab kisi
    //       institute ke liye naya admin banata hai, to woh email
    //       `admins/{email}` collection mein ek doc { active: true }
    //       ke saath likh deta hai. Wahi admin par yahan check hota
    //       hai — aur "active" false karte hi (Owner "Disable" button
    //       dabaye) us admin ka access turant band ho jaata hai, bina
    //       Firebase Auth account delete kiye.
    //
    // ⚠️ FIX (v24_12): pehle LEGACY email ko bina kisi condition ke
    // hardcoded "true" mil jaata tha — matlab Owner Panel se ise
    // "Disable" karne ka (admins/{email}.active = false likhne ka)
    // koi asar hi nahi hota tha, kyunki neeche wala hardcoded check
    // active field dekhta hi nahi tha. Ab legacy email ko bhi access
    // milta hai SIRF tab tak jab tak uske admins/{email} doc mein
    // explicitly active:false na likha ho — Owner "Disable" dabaye to
    // ye legacy admin bhi turant, sach mein, block ho jaata hai.
    function adminDocActive() {
      return exists(/databases/$(database)/documents/admins/$(request.auth.token.email))
        ? get(/databases/$(database)/documents/admins/$(request.auth.token.email)).data.active
        : null;
    }

    // ⚠️ FIX (v24_16): pehle isAdmin() sirf admin ke APNE doc ka `active`
    // field dekhta tha — Owner Panel ke Institute-level "Deactivate"
    // button (jo `institutes/{id}.active = false` likhta hai) ka is par
    // koi asar hi nahi padta tha. Matlab ek poora institute deactivate
    // karne ke baad bhi uska admin poora access rakhta reh sakta tha —
    // aur isi wajah se koi real-time force-logout bhi trigger nahi hota
    // tha (wo sirf admin-doc ke `active:false`/permission-denied par
    // depend karta hai, script.js dekhein). Ab isAdminEmailAllowed() —
    // sirf email/admin-doc wala purana check — ko isAdmin() se ALAG kiya
    // gaya hai (taaki adminInstituteId() ise call kar sake bina circular
    // function-call error ke), aur isAdmin() khud ab institute active
    // bhi check karta hai.
    function isAdminEmailAllowed() {
      return request.auth != null &&
        request.auth.token.email != null &&
        (
          (
            request.auth.token.email in [
              "vishnu1234stmp@gmail.com"
            ]
            && adminDocActive() != false
          )
          ||
          adminDocActive() == true
        );
    }

    // ⚠️ FIX (v26 — disable vs. institute-deactivate ka sahi message):
    // Pehle admin apna khud ka "admins/{email}" doc SIRF isAdmin() (jo
    // active + institute dono check karta hai) hone par hi padh sakta
    // tha — matlab jaise hi Owner ne "Disable" dabaya YA institute
    // deactivate kiya, doc ka read hi "permission-denied" ho jaata tha,
    // aur client (script.js) dono cases ko ALAG bata hi nahi paata tha
    // (dono taraf se sirf ek generic "permission-denied" milta tha).
    // Fix: apna khud ka doc padhna sirf isi baat par depend kare ki
    // email admin allow-list mein hai ya nahi (chahe abhi active ho ya
    // na ho) — active/institute-status ka asli WRITE-level gate
    // (isAdmin()) bilkul waisa hi sakht rehta hai, sirf "apna record
    // dekh sakna" thoda khula hai taaki client sahi wajah dikha sake.
    function isKnownAdminEmail() {
      return request.auth != null &&
        request.auth.token.email != null &&
        (
          request.auth.token.email in [
            "vishnu1234stmp@gmail.com"
          ]
          || exists(/databases/$(database)/documents/admins/$(request.auth.token.email))
        );
    }

    // ── Multi-tenant: is admin ka apna institute kaunsa hai ────────
    // Owner Panel se bane admin ke `admins/{email}` doc mein instituteId
    // already hota hai. Legacy admin ke liye app khud (script.js,
    // resolveCurrentAdminInstitute()) pehle login par ek instituteId
    // bana kar isi doc mein likh deta hai — isliye ye function har
    // admin ke liye kaam karta hai, chahe wo Owner Panel se bana ho ya
    // purana/legacy ho.
    function adminInstituteId() {
      return isAdminEmailAllowed() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.token.email))
        ? get(/databases/$(database)/documents/admins/$(request.auth.token.email)).data.instituteId
        : null;
    }

    // Admin ka apna institute record active hai ya nahi.
    //   - Koi instituteId hi nahi (legacy, migrate hone se pehle) →
    //     true maan lo (backward compat, jaisa baaki purana code karta
    //     hai — isse koi turant lock-out nahi hota).
    //   - instituteId hai par institute doc hi maujood nahi (orphan,
    //     "🗑️ Remove" se hata diya gaya) → true maan lo — ye jaan-boojh
    //     kar hai, kyunki Owner Panel ka apna documentation kehta hai
    //     "institute hatane se admin ka access khud disable nahi hota".
    //   - Institute doc hai aur `active` explicitly false hai (Owner ne
    //     Deactivate dabaya) → sirf tabhi false.
    function adminInstituteActive() {
      return adminInstituteId() == null ||
        !exists(/databases/$(database)/documents/institutes/$(adminInstituteId()))
        ? true
        : get(/databases/$(database)/documents/institutes/$(adminInstituteId())).data.active != false;
    }

    function isAdmin() {
      return isAdminEmailAllowed() && adminInstituteActive();
    }

    // ── FIX (v133 — cross-institute admin isolation) ────────────────
    // Pehle isAdmin() sirf itna check karta tha ki "koi active admin
    // hai" — ye kabhi nahi dekhta tha ki TARGET student usी admin ke
    // apne institute ka hai ya kisi doosre ka. Matlab Institute A ka
    // admin, Institute B ke kisi bhi student ka password reset/delete
    // kar sakta tha. Ab har jagah jahan admin kisi SPECIFIC student
    // (uske mobile se) par action leta hai, ye function bhi check
    // hota hai.
    //
    // Backward-compat (upar wale patterns jaisa): agar target student
    // ka `students/{mobile}` doc hi exist nahi karta (abhi register
    // nahi hua — studentSecrets create is se pehle hota hai) YA uska
    // koi instituteId set nahi hai (bahut purana, multi-institute
    // feature se pehle ka student) — to allow kar diya jaata hai,
    // taaki koi turant lock-out na ho.
    function studentBelongsToAdmin(mobile) {
      return !exists(/databases/$(database)/documents/students/$(mobile)) ||
        get(/databases/$(database)/documents/students/$(mobile)).data.instituteId == null ||
        get(/databases/$(database)/documents/students/$(mobile)).data.instituteId == adminInstituteId();
    }

    // ── Class Eligibility (v25) — Multi-Institute Shared Question Bank ──
    // Har Institute ke `institutes/{id}.allowedClasses` mein un Classes
    // ki list hoti hai jinke liye wo eligible hai (jaise ["class_10"]).
    // Ye Master Question Bank/Exam data ko Institute-wise DIVIDE nahi
    // karti — do institutes jo dono "class_10" ke liye eligible hain,
    // unhe class_10 ka poora data barabar milega. Ye sirf itna control
    // karti hai ki kaun-si Class ka data kis Institute ko dikhega.
    //
    // Backward-compat (bilkul upar wale instituteId pattern jaisa):
    //   - `allowedClasses` field hi nahi hai (purana institute, is
    //     feature se pehle bana) → null → sab Classes allowed maani
    //     jaati hain, koi turant lock-out nahi hota.
    //   - Doc mein `classId` hi nahi hai (purana exam, is feature se
    //     pehle bana) → check hi skip ho jaata hai (backward compat).
    function adminAllowedClasses() {
      return adminInstituteId() != null &&
        exists(/databases/$(database)/documents/institutes/$(adminInstituteId())) &&
        ('allowedClasses' in get(/databases/$(database)/documents/institutes/$(adminInstituteId())).data)
        ? get(/databases/$(database)/documents/institutes/$(adminInstituteId())).data.allowedClasses
        : null;
    }

    function classAllowedForAdmin(classId) {
      return classId == null ||
        adminAllowedClasses() == null ||
        (classId in adminAllowedClasses());
    }

    // Koi bhi signed-in visitor — chahe anonymous ho ya admin.
    // (App load hote hi anonymous sign-in ho jata hai, isliye ye
    //  practically "app se aaya hua request" ke barabar hai, random
    //  script/bot ke barabar nahi.)
    function isSignedIn() {
      return request.auth != null;
    }

    // ── Public/shared content: question bank & tests ─────────────
    // Student app ko ye padhna zaroori hai taaki test/questions load ho
    // sakein. Likhna/delete karna sirf admin kar sakta hai.
    //
    // ⚠️ OWNERSHIP-BASED DELETE PROTECTION (added — "dushmani" fix):
    // Pehle YE HAR active admin poore shared questionBank mein KISI BHI
    // question ko delete kar sakta tha — chahe wo unhone khud upload
    // kiya ho ya kisi doosre admin/institute ne. Ab:
    //   - Naya question banate waqt uska `createdBy` field khud
    //     request bhejne wale admin ke email se match karna ZAROORI
    //     hai (client spoof nahi kar sakta — server-side check).
    //   - Update karte waqt `createdBy` ko badla nahi ja sakta (sirf
    //     Owner badal sakta hai) — taaki koi edit karke ownership
    //     "chura" na sake.
    //   - Delete sirf 2 log kar sakte hain: (1) Owner (hamesha), ya
    //     (2) wahi admin jiska email `createdBy` mein hai. Purane
    //     (is fix se pehle bane / seeded) questions jinme `createdBy`
    //     field hai hi nahi, unke liye backward-compat rakha gaya hai
    //     — koi bhi active admin unhe delete kar sakta hai (jaisa
    //     pehle tha), taaki purana data lock na ho jaaye.
    // Client-side (script.js / qgen-app.js) ko naya question banate
    // waqt `createdBy: <apna email>` field bhejna zaroori hai, warna
    // create hi reject ho jayega.
    match /questionBank/{docId} {
      allow read: if isSignedIn();
      allow create: if isAdmin() && (
        isOwner() ||
        !('createdBy' in request.resource.data) ||
        request.resource.data.createdBy == request.auth.token.email
      );
      allow update: if isAdmin() && (
        !('createdBy' in resource.data) ||
        request.resource.data.createdBy == resource.data.createdBy ||
        isOwner()
      );
      allow delete: if isOwner() || (isAdmin() && (
        !('createdBy' in resource.data) ||
        resource.data.createdBy == request.auth.token.email
      ));
    }

    match /tests/{docId} {
      // Read khula rehta hai (isSignedIn()) — students ko sabhi tests
      // dikhne zaroori hain taaki wo attempt kar sakein. Institute-wise
      // isolation sirf ADMIN ke apne management view (Tests list, Edit,
      // Delete) mein hai — write side par.
      allow read: if isSignedIn();

      // Naya test — sirf apne institute ke instituteId ke saath ban
      // sakta hai (ya instituteId field hi na ho, purane app-version
      // compatibility ke liye).
      allow create: if isAdmin() && (
        !('instituteId' in request.resource.data) ||
        request.resource.data.instituteId == adminInstituteId()
      );

      // Edit/Delete — sirf wahi admin kar sakta hai jiska instituteId us
      // test ke instituteId se match kare. Purane (migrate hone se pehle)
      // instituteId-less docs par abhi bhi access hai — taaki koi turant
      // lock-out na ho jaaye, migration hote hi ye apne aap tight ho
      // jaata hai.
      allow update, delete: if isAdmin() && (
        !('instituteId' in resource.data) ||
        resource.data.instituteId == adminInstituteId()
      );

      // ── Nested subcollection fix ──────────────────────────────────
      // Test ke questions "tests/{id}/qchunks/{chunkId}" subcollection
      // mein save hote hain (1MB doc-limit se bachne ke liye). Firestore
      // rules mein har collection/subcollection ka apna alag match
      // chahiye — upar wala "tests/{docId}" rule sirf test ke main doc
      // par lagu hota hai, is nested subcollection par nahi. Isi wajah
      // se pehle "Save Test Online" hamesha "Missing or insufficient
      // permissions" ke saath fail ho raha tha aur test 0 questions par
      // atka reh jaata tha.
      match /qchunks/{chunkId} {
        allow read: if isSignedIn();
        allow write: if isAdmin();
      }
    }

    // ── Admin-only working data (trash bin, drafts, chunks, keys) ──
    // Inhe students ko kabhi dekhne/chhedne ki zaroorat nahi.
    match /deletedQuestions/{docId} {
      allow read, write: if isAdmin();
    }

    // Permanent record of question IDs that admin ne kabhi delete kiya —
    // isse seed functions unhe dobara Firebase mein wapas nahi likhte,
    // chahe Recycle Bin se "Delete Forever" bhi kyun na ho gaya ho.
    match /seedExclusions/{docId} {
      allow read, write: if isAdmin();
    }

    match /deletedTests/{docId} {
      allow read, write: if isAdmin();
    }

    match /pdfDrafts/{docId} {
      allow read, write: if isAdmin();
    }

    match /draftQuestions/{docId} {
      allow read, write: if isAdmin();
    }

    match /qchunks/{docId} {
      allow read, write: if isAdmin();
    }

    // omrTemplates: admin ne khud "🎯 Naya Sheet Sikhayein" se train ki
    // hui custom OMR sheet layouts — sirf admin panel scan/train karta
    // hai, students ka isse koi lena-dena nahi, isliye admin-only.
    match /omrTemplates/{docId} {
      allow read, write: if isAdmin();
    }

    // examManagerExams: OMR hub ke "🗂️ Exam Manager" section ke offline/
    // paper exams (naam, answer key, scan-count, reports) — sirf admin
    // banata/manage karta hai, students ka isse koi lena-dena nahi.
    match /examManagerExams/{docId} {
      // Institute-wise isolation: apna institute ke exams hi read/write
      // ho sakte hain. Purane (migrate hone se pehle) instituteId-less
      // docs par abhi bhi access hai, taaki koi turant lock-out na ho —
      // pehli login par app khud unhe migrate kar deta hai (script.js,
      // resolveCurrentAdminInstitute()).
      allow read: if isAdmin() && (
        !('instituteId' in resource.data) ||
        resource.data.instituteId == adminInstituteId()
      );
      // Class Eligibility (v25): agar exam par classId lagi hai, to wo
      // classId admin ke institute ki allowedClasses list mein honi
      // chahiye — warna backend hi request reject kar deta hai (frontend
      // par dropdown chhupana kaafi nahi hai, jaisa master-prompt rule
      // 14 mein bataya gaya hai).
      allow create: if isAdmin() && (
        !('instituteId' in request.resource.data) ||
        request.resource.data.instituteId == adminInstituteId()
      ) && classAllowedForAdmin(
        'classId' in request.resource.data ? request.resource.data.classId : null
      );
      allow update: if isAdmin() && (
        !('instituteId' in resource.data) ||
        resource.data.instituteId == adminInstituteId()
      ) && (
        !('instituteId' in request.resource.data) ||
        request.resource.data.instituteId == adminInstituteId()
      ) && classAllowedForAdmin(
        'classId' in request.resource.data ? request.resource.data.classId : null
      );
      allow delete: if isAdmin() && (
        !('instituteId' in resource.data) ||
        resource.data.instituteId == adminInstituteId()
      );

      // scanPhotos subcollection: sharp (900px) scanned OMR photos, one
      // doc per result — kept OUT of the parent exam doc so each photo
      // gets its own independent 1MB Firestore budget instead of sharing
      // the parent doc's 1MB across every result. Same nested-rule
      // requirement as tests/{docId}/qchunks above — a parent match does
      // NOT cover a subcollection.
      match /scanPhotos/{resultId} {
        allow read, write: if isAdmin();
      }

      // scanResults subcollection: one small doc per scanned OMR result
      // (roll, marks, answers, thumb, etc.) — kept OUT of the parent exam
      // doc's `results` array on purpose. Every scan used to append to
      // that single array field via arrayUnion(), so the write got bigger
      // and slower to process the longer a scanning session ran (session
      // -duration slowdown, separate from the per-frame camera hang fixed
      // above). One doc per result here means every scan's write stays
      // the same small size no matter how long the session runs. Same
      // nested-rule requirement as scanPhotos above — a parent match does
      // NOT cover a subcollection.
      match /scanResults/{resultId} {
        allow read, write: if isAdmin();
      }
    }

    // app_settings holds sensitive things like the Groq AI API key —
    // admin-only, full stop.
    match /app_settings/{docId} {
      allow read, write: if isAdmin();
    }

    // Legacy admin-credentials doc (old hash-based system). Kept locked
    // to admin only; safe to ignore/delete once migration is complete.
    match /appSettings/{docId} {
      allow read, write: if isAdmin();
    }

    // ── Student accounts & records ────────────────────────────────
    // "students/{mobile}" ab sirf PUBLIC-ish profile info rakhta hai:
    // naam, mobile, aur ek "hasPin" flag. Password hash / PIN hash
    // yahan KABHI nahi jaate — wo neeche "studentSecrets" mein locked
    // rehte hain. Isliye is doc ka simple isSignedIn() access theek hai.
    // DELETE sirf admin kar sakta hai — isse accidental/malicious mass
    // data-loss nahi ho sakta.
    match /students/{mobile} {
      allow get, create: if isSignedIn();

      // ⚠️ FIX (v133): pehle "update" poori tarah khula tha
      // (isSignedIn()) — koi bhi signed-in (anonymous) visitor kisi
      // bhi doosre student ka naam/institute/class seedha badal sakta
      // tha, sirf uska mobile number jaan kar. Ab: bina-proof
      // self-service update sirf in FIXED, non-identity fields tak
      // simit hai (jo app ke sabhi current student-side flows —
      // DP photo, Security PIN set, legacy-secret migration cleanup,
      // daily streak — use karte hain). naam/instituteId/classId/
      // mobile in mein NAHI hain, isliye koi bhi current student-flow
      // yahan nahi tootta.
      // Admin apne hi institute ke student ke liye ye sab (naam/
      // institute/class/proof-fields samet) poori tarah badal sakta
      // hai — jaise "Proof Update" form se.
      allow update: if (
        isAdmin() && studentBelongsToAdmin(mobile)
      ) || (
        isSignedIn() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'photoDataUrl', 'hasPin', 'hash', 'pinHash',
          'streakCount', 'lastActiveDate'
        ])
      );

      // ⚠️ FIX (v133): list ab admin ke apne institute (ya
      // institute-less legacy students) tak simit hai — pehle koi
      // bhi active admin PORE platform ke saare students (naam,
      // mobile, class, sab institutes) ek saath list kar sakta tha.
      allow list: if isAdmin() && (
        resource.data.instituteId == null ||
        resource.data.instituteId == adminInstituteId()
      );

      allow delete: if isAdmin() && studentBelongsToAdmin(mobile);
    }

    // ── Student secrets (password hash + Security PIN hash) ────────
    // ══════════════════════════════════════════════════════════════
    // SECURITY FIX: pehle hash/pinHash "students/{mobile}" doc mein
    // hote the, jise koi bhi signed-in (anonymous bhi) client seedha
    // `.get()` kar sakta tha — matlab jis kisi ko bhi student ka mobile
    // number pata ho, wo uska password/PIN hash padh kar offline crack
    // kar sakta tha, YA seedha `.set({hash: ...})` bulakar bina kuch
    // proof diye hi password overwrite kar sakta tha. Yahi wo bug tha
    // jiski wajah se "kisi ka bhi password koi bhi reset kar sakta tha
    // agar uska number pata ho".
    //
    // FIX: is collection ko admin ke alawa kisi ke liye bhi `read`
    // allowed nahi — student kabhi apna hash/pinHash seedha nahi
    // padhta. Login aur "password bhool gaye" ab ek chhoti si WRITE
    // attempt karte hain (sha256(entered password/PIN) ke saath), aur
    // Firestore Rules khud, server-side, use stored hash se compare
    // karti hain — sahi na ho to write reject (permission-denied) ho
    // jaata hai. Isse secret kabhi client tak pahunchta hi nahi.
    // ══════════════════════════════════════════════════════════════
    match /studentSecrets/{mobile} {
      // ⚠️ FIX (v133): admin ab sirf apne HI institute ke student ka
      // password-hash/PIN-hash padh/reset/delete kar sakta hai — pehle
      // koi bhi active admin, kisi bhi doosre institute ke student ka
      // password yahan se reset karke uske account mein "ghus" sakta
      // tha.
      allow read: if isAdmin() && studentBelongsToAdmin(mobile);

      // Registration (aur legacy-account migration) — pehli baar create.
      allow create: if isSignedIn();

      allow update: if (isAdmin() && studentBelongsToAdmin(mobile)) ||
        (
          // (a) LOGIN proof: client bhejta hai lastLoginProof = sha256(entered
          // password); tabhi accept hoga jab ye stored "hash" se match kare.
          isSignedIn() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastLoginProof', 'lastLoginAt']) &&
          request.resource.data.lastLoginProof == resource.data.hash
        ) ||
        (
          // (b) Pehli baar Security PIN set karna — sirf tabhi jab abhi
          // tak koi pinHash set na ho (isliye koi baad mein bina purana
          // PIN jaane ise overwrite nahi kar sakta).
          isSignedIn() &&
          !('pinHash' in resource.data) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pinHash'])
        ) ||
        (
          // (c) PASSWORD RESET via PIN: client bhejta hai naya "hash" +
          // pinProof = sha256(entered PIN); tabhi accept hoga jab pinProof
          // stored "pinHash" se match kare.
          isSignedIn() &&
          'pinHash' in resource.data &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hash', 'pinProof']) &&
          request.resource.data.pinProof == resource.data.pinHash
        );

      allow delete: if isAdmin() && studentBelongsToAdmin(mobile);
    }

    match /studentRecords/{docId} {
      allow get, create, update: if isSignedIn();
      allow list: if isSignedIn();
      allow delete: if isAdmin();
    }

    // ── Scanned paper/OMR exam reports linked to a student ─────────
    // Written by admin (Exam Manager → Report Detail → 🔗 Link to
    // Student) when a scanned result's roll number is matched to a
    // real student account. Student's "My Result" screen reads these
    // by mobile — same read/write trust model as studentRecords above,
    // but writes stay admin-only since linking is an admin action.
    match /studentScanReports/{docId} {
      allow get, list: if isSignedIn();

      // ⚠️ FIX (v133): create/update/delete ab admin ke apne institute
      // ke student tak simit hai (doc ke `mobile` field se check hota
      // hai) — pehle koi bhi active admin kisi bhi doosre institute ke
      // student ka scanned OMR result unse link/unlink/delete kar
      // sakta tha.
      allow create: if isAdmin() &&
        'mobile' in request.resource.data &&
        studentBelongsToAdmin(request.resource.data.mobile);
      allow update: if isAdmin() &&
        'mobile' in request.resource.data &&
        studentBelongsToAdmin(request.resource.data.mobile);
      allow delete: if isAdmin() &&
        (!('mobile' in resource.data) || studentBelongsToAdmin(resource.data.mobile));
    }

    // ── My Mistakes (auto-collected wrong answers, per student) ────
    // Doc id = student's mobile number. Same trust model as
    // "students/{mobile}" above — any signed-in client can read/write
    // its own or (in principle) another student's mistake list, but
    // there's nothing sensitive here (just question text + answers
    // already visible in the question bank). Delete stays admin-only.
    match /studentMistakes/{mobile} {
      allow get, create, update: if isSignedIn();
      allow list: if isAdmin();
      // ⚠️ FIX (v133): admin ke apne institute ke student tak simit.
      allow delete: if isAdmin() && studentBelongsToAdmin(mobile);
    }

    // ── OWNER PANEL: institutes & their admins ─────────────────────
    // Sirf owner in dono collections ko padh/likh sakta hai — koi
    // admin (chahe apna hi record ho) inhe seedha nahi chhed sakta.
    // Admin ki apni access `isAdmin()` ke andar wale `exists()`/`get()`
    // check se hi tay hoti hai, is doc ko read kiye bina.
    match /institutes/{instituteId} {
      allow read, write: if isOwner();

      // v25: Student Registration ke Institute+Class dropdown ke liye
      // koi bhi signed-in (anonymous student bhi) institutes ki basic
      // list (naam + allowedClasses) padh sake — isme koi sensitive
      // data nahi hai (admin emails yahan kabhi nahi aate).
      allow read: if isSignedIn();

      // ── Legacy-admin self-migration ──────────────────────────────
      // Purana admin (Owner Panel se nahi, seedha ADMIN_EMAILS list se
      // aaya hua) ke paas koi instituteId nahi hoti. App khud (script.js,
      // resolveCurrentAdminInstitute()) pehli login par uske liye ek
      // institute record banata hai — taaki wo Owner Panel mein bhi
      // dikhe aur uska purana data isolate ho sake. Sirf CREATE allowed
      // hai (apna record ek baar banane ke liye), update/delete nahi —
      // aur ID hamesha "legacy_" se shuru hona zaroori hai (Owner Panel
      // ke ".add()" se bane real institute IDs kabhi is prefix se
      // shuru nahi hote), taaki koi admin kisi real/doosre institute ko
      // kabhi chhed na sake.
      allow read: if isAdmin();
      allow create: if isAdmin() && instituteId.matches('^legacy_.*');

      // ── ID Card feature (v111) ────────────────────────────────────
      // (a) Admin apne HI institute ka logo upload/badal sake (ID Card
      //     ke corner-logo ke liye) — sirf `logoDataUrl` field, koi aur
      //     field (name/active/allowedClasses waghera) is rule se nahi
      //     chhed sakta.
      allow update: if isAdmin() && instituteId == adminInstituteId() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['logoDataUrl']);

      // (a2) v132: Institute Join Code protection ka ON/OFF flag — sirf
      //      `requiresJoinCode` field. Asli code yahan kabhi nahi aata
      //      (woh alag, protected `instituteJoinCodes` collection mein
      //      hai) — yeh sirf ek public "haan/na" flag hai jisse
      //      registration form ko pata chale ki code maangna hai ya
      //      nahi, bina asli code kisi ko dikhaye.
      allow update: if isAdmin() && instituteId == adminInstituteId() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['requiresJoinCode']);

      // (b) Har student ka ID Number ek institute-wide serial number
      //     (studentSerialCounter) se banta hai — student ka apna client
      //     hi (pehli baar registration/ID Card khulte waqt) ise ek
      //     Firestore TRANSACTION mein +1 badhata hai. Isliye koi bhi
      //     signed-in client (sirf apna institute nahi, koi bhi — kyunki
      //     student ka apna instituteId yahan verify karne ka koi safe
      //     tareeka nahi hai bina ek aur read ke) ise chhoo sakta hai,
      //     PAR sirf ISI ek field ko, aur sirf pichle value se THEEK +1
      //     karke — na kam, na zyada, na koi bhi random value. Isse
      //     zyada se zyada koi doosre institute ka counter bewajah +1
      //     kar sakta hai (koi sensitive data expose/corrupt nahi hota).
      allow update: if isSignedIn() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['studentSerialCounter']) &&
        request.resource.data.studentSerialCounter ==
          (('studentSerialCounter' in resource.data) ? resource.data.studentSerialCounter : 0) + 1;
    }

    // ── Institute Join Code protection (v132) ──────────────────────
    // ══════════════════════════════════════════════════════════════
    // PROBLEM: Registration form mein student sirf ek dropdown se
    // apna institute chun leta tha — koi bhi student, kisi bhi
    // institute ka naam dekh kar, seedha usme "ghus" sakta tha, bina
    // us institute se koi permission liye.
    //
    // FIX (bilkul studentSecrets/password wale pattern jaisa): asli
    // code kabhi client ko `read` nahi hota — sirf isAdmin() (apne hi
    // institute ke liye) ise dekh/badal sakta hai. Student jab
    // register karta hai, wo apna guess ek ALAG throwaway collection
    // (`instituteJoinCodeChecks`) mein CREATE karne ki koshish karta
    // hai; Firestore Rules khud (server-side, `get()` se) us guess ko
    // stored code se compare karti hain — sirf tabhi create allow
    // hota hai jab match ho. Client ko kabhi asli code dikhta hi
    // nahi, sirf pata chalta hai ki uska attempt "allow" hua ya
    // "permission-denied" mila.
    // ══════════════════════════════════════════════════════════════
    match /instituteJoinCodes/{instituteId} {
      allow read, write: if isOwner();
      // Admin apne hi institute ka code set/badal/dekh sake (students
      // ko dene ke liye) — kisi doosre institute ka nahi.
      allow read, create, update: if isAdmin() && instituteId == adminInstituteId();
    }

    match /instituteJoinCodeChecks/{checkId} {
      allow read, update, delete: if isOwner();
      // Koi bhi signed-in client (anonymous student bhi) apna code
      // "guess" yahan submit kar sakta hai — par CREATE sirf tabhi
      // safal hota hai jab woh guess us institute ke stored code se
      // exactly match kare. Agar institute ne abhi tak koi code set
      // hi nahi kiya (instituteJoinCodes doc exist nahi karta), to
      // backward-compatibility ke liye check khud-ba-khud pass ho
      // jaata hai — matlab jab tak admin khud apna code set na kare,
      // uske institute ka registration pehle jaisa hi (bina code ke)
      // chalta rehta hai.
      allow create: if isSignedIn() &&
        'instituteId' in request.resource.data &&
        'codeAttempt' in request.resource.data &&
        (
          !exists(/databases/$(database)/documents/instituteJoinCodes/$(request.resource.data.instituteId)) ||
          request.resource.data.codeAttempt ==
            get(/databases/$(database)/documents/instituteJoinCodes/$(request.resource.data.instituteId)).data.code
        );
    }

    // Doc ID = admin ka email address (isAdmin() function isi se
    // seedha lookup karta hai — /admins/{unka-email}).
    match /admins/{email} {
      allow read, write: if isOwner();

      // Admin apna khud ka record padh sake (apna instituteId maalum
      // karne ke liye). Legacy admin (jiska record abhi tak hai hi
      // nahi) ke liye khud bana/update bhi kar sakta hai — sirf apne
      // hi email wale doc par, sirf "legacy_" institute ke saath, aur
      // ek baar instituteId set hone ke baad khud se badal nahi sakta
      // (privilege-escalation se bachne ke liye).
      allow read: if isKnownAdminEmail() && request.auth.token.email == email;
      allow create: if isAdmin() && request.auth.token.email == email &&
        request.resource.data.instituteId.matches('^legacy_.*');
      allow update: if isAdmin() && request.auth.token.email == email &&
        resource.data.instituteId == request.resource.data.instituteId;
    }

    // ── OWNER PANEL: institute-removal OTP/confirm-link gate (v26) ──
    // "Remove" ab seedha delete nahi karta — pehle ek pending-removal
    // token yahan likha jaata hai, phir Owner ke registered email par
    // ek confirm-link bheja jaata hai (Firebase Auth ka apna, free,
    // signed/unforgeable email-link mechanism — bina kisi paid backend
    // ke). Sirf jab wahi link wapas click karke verify ho, tabhi asli
    // institute delete hota hai — isse ek galti se tap/refresh se koi
    // institute turant hamesha ke liye nahi mit sakta.
    match /ownerPendingRemovals/{token} {
      allow read, write: if isOwner();
    }

    // ── Default deny ──────────────────────────────────────────────
    // Koi bhi collection jo upar explicitly list nahi hui, uska
    // access poori tarah band. Ye "test mode" jaisi open-access
    // galti se dobara hone se rokta hai.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
