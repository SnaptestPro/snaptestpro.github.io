rules_version = '2';
// Firebase Console -> Storage -> Rules -> paste -> Publish
// v168: Batch files ab institute + batch-membership ke hisaab se protected hain (Firestore se cross-service check).
//  - Likh/delete: sirf email-login admin; agar admins/{email}.instituteId set hai to wo path ke instituteId se match karna zaroori.
//  - Padhna: admin (apna institute) ya student — Strict Mode ON ho to sirf us batch ka verified member; OFF ho to purane jaisa (signed-in).
// Zaroori: Storage Rules cross-service get() ke liye Firebase Console me Rules publish karte waqt "Grant access" prompt aaye to Allow karein.
service firebase.storage {
  match /b/{bucket}/o {
    match /batches/{inst}/{batch}/{file} {
      function adminDoc() { return firestore.get(/databases/(default)/documents/admins/$(request.auth.token.email)).data; }
      function isEmailUser() { return request.auth != null && request.auth.token.email != null; }
      function isInstAdmin() {
        return isEmailUser() &&
          (!firestore.exists(/databases/(default)/documents/admins/$(request.auth.token.email)) ||
           adminDoc().get('instituteId', inst) == inst);
      }
      function strict() {
        return firestore.exists(/databases/(default)/documents/institutes/$(inst)/batchSettings/security) &&
          firestore.get(/databases/(default)/documents/institutes/$(inst)/batchSettings/security).data.get('strict', false) == true;
      }
      function sessionMobile() {
        return firestore.exists(/databases/(default)/documents/studentSessions/$(request.auth.uid))
          ? firestore.get(/databases/(default)/documents/studentSessions/$(request.auth.uid)).data.mobile : null;
      }
      function isMember() {
        return sessionMobile() != null &&
          firestore.exists(/databases/(default)/documents/institutes/$(inst)/batches/$(batch)/members/$(sessionMobile()));
      }
      allow read: if request.auth != null && (!strict() || (isInstAdmin() && isEmailUser()) || isMember());
      allow create, update: if isInstAdmin() && request.resource.size < 50 * 1024 * 1024;
      allow delete: if isInstAdmin();
    }
  }
}
